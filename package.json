{
    "name": "atlas-airfare-loan-manager",
    "version": "2.1.0",
    "description": "ATLAS Airfare and Loan Manager backend for MSSQL.",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "check": "node --check server.js",
        "setup": "powershell -ExecutionPolicy Bypass -File .\\setup-atlas.ps1",
        "setup:repair": "powershell -ExecutionPolicy Bypass -File .\\setup-atlas.ps1 -Repair",
        "setup:troubleshoot": "powershell -ExecutionPolicy Bypass -File .\\setup-atlas.ps1 -Troubleshoot",
        "test:smoke": "node tests/atlas-smoke-test.js",
        "test:loan-sql": "node tests/loan-sql-objects.test.js",
        "test:attachments-sql": "node tests/allocation-attachments-sql.test.js",
        "test:company-admin": "node tests/company-admin-sql.test.js",
        "test:release-manifest": "node tests/release-manifest-contract.test.js",
        "test:preferences-api": "node tests/preferences-api-contract.test.js",
        "test:preferences-route": "node tests/preferences-route-artifact.test.js",
        "test:post-patch-smoke": "node tests/post-patch-smoke.test.js",
        "test:continuous-entitlement": "node tests/continuous-entitlement-blueprint.test.js",
        "test:continuous-entitlement-removal-plan": "node tests/year-end-removal-migration-plan.test.js",
        "test:airfare-entitlement-phase1": "node tests/airfare-entitlement-phase1.test.js",
        "test:continuous-entitlement-execution-runbook": "node tests/year-end-execution-runbook.test.js",
        "test:patch-2-3-89": "node tests/continuous-entitlement-blueprint.test.js && node tests/airfare-entitlement-phase1.test.js && node tests/patch-2-3-89-continuous-entitlement.test.js && npm run test:patch-2-3-89-implementation",
        "test:continuous-entitlement-master-runbook": "node tests/year-end-master-runbook.test.js",
        "test:patch-2-3-89-implementation": "node --check server.js && node tests/patch-2-3-89-implementation.test.js",
        "test:airfare-integration": "node tests/airfare-entitlement-live-api.test.js",
        "test:e2e:airfare": "npx playwright test tests/e2e/airfare-entitlement-reconciliation.spec.ts",
        "test:e2e:hcm": "npx playwright test --project=chromium",
        "test:e2e:visual": "npx playwright test --project=visual",
        "test:e2e:visual:update": "npx playwright test --project=visual --update-snapshots",
        "test:e2e": "npx playwright test --project=chromium",
        "test:e2e:aggregate": "python tests/qa-agent/aggregate_playwright_results.py",
        "test:e2e:suite": "npx playwright test --project=chromium && npx playwright test --project=visual && npm run test:e2e:aggregate",
        "test:qa:baseline:refresh": "npx playwright test --project=visual --update-snapshots",
        "test:qa:baseline:verify": "npx playwright test --project=visual",
        "test:agentic": "python tests/agentic_qa_runner.py",
        "test:agentic:hcm": "cd \"C:\\HCM Airfare\" && .\\.venv\\Scripts\\python.exe tests\\agentic_qa_runner.py",
        "test:load": "k6 run tests/load/ai-agent-endpoints.k6.js",
        "test:load:agent": "k6 run tests/load/ai-agent-endpoints.k6.js",
        "test:qa:agent": "python tests/qa-agent/orchestrate_post_run.py",
        "test:qa": "npm run test:qa:static && npm run test:agentic:hcm && npm run test:e2e:suite && npm run test:qa:agent",
        "test:qa:full": "npm run test:qa && npm run test:load:agent && npm run test:qa:agent",
        "test:qa:static": "npm --prefix atlas-next run typecheck && node --test atlas-next/tests/*.mjs",
        "test:qa:ci-local": "npm run test:qa:static && npm run test:qa",
        "test:airfare-load": "k6 run tests/load/airfare-entitlement-balance.k6.js",
        "lighthouse:airfare-reconciliation": "npx lighthouse http://127.0.0.1:3389 --output json --output html --output-path ./test-reports/lighthouse-airfare-reconciliation --quiet",
        "test:local-admin-reset-helper": "node tests/local-admin-password-reset-helper.test.js",
        "test:full": "node tests/full-system-test.js",
        "test:phase1": "node tests/phase1-smoke-test.js",
        "test:employee-status": "node tests/employee-status-eligibility.test.js",
        "test:entitlement-safety": "node tests/patch-2-3-89-continuous-entitlement.test.js && node tests/patch-2-3-89-implementation.test.js",
        "test:continuous-entitlement-safety": "npm run test:entitlement-safety",
        "deploy:devops": "powershell -ExecutionPolicy Bypass -File .\\tools\\Deploy-ATLAS-DevOps.ps1",
        "verify:env": "powershell -ExecutionPolicy Bypass -File .\\tools\\Verify-ATLAS-Environment.ps1"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "helmet": "^8.0.0",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "mssql": "^11.0.1",
        "uuid": "^11.0.5",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1"
    }
}
