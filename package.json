{
    "name":  "atlas-airfare-loan-manager",
    "version":  "2.1.0",
    "description":  "ATLAS Airfare and Loan Manager backend for MSSQL.",
    "main":  "server.js",
    "scripts":  {
                    "start":  "node server.js",
                    "check":  "node --check server.js",
                    "setup":  "powershell -ExecutionPolicy Bypass -File .\\setup-atlas.ps1",
                    "setup:repair":  "powershell -ExecutionPolicy Bypass -File .\\setup-atlas.ps1 -Repair",
                    "setup:troubleshoot":  "powershell -ExecutionPolicy Bypass -File .\\setup-atlas.ps1 -Troubleshoot",
                    "test:smoke":  "node tests/atlas-smoke-test.js",
                    "test:loan-sql":  "node tests/loan-sql-objects.test.js",
                    "test:attachments-sql":  "node tests/allocation-attachments-sql.test.js",
                    "test:company-admin":  "node tests/company-admin-sql.test.js",
                    "test:release-manifest":  "node tests/release-manifest-contract.test.js",
                    "test:preferences-api":  "node tests/preferences-api-contract.test.js",
                    "test:preferences-route":  "node tests/preferences-route-artifact.test.js",
                    "test:post-patch-smoke":  "node tests/post-patch-smoke.test.js",
                    "test:continuous-entitlement":  "node tests/continuous-entitlement-blueprint.test.js",
                    "test:year-end-removal-plan":  "node tests/year-end-removal-migration-plan.test.js",
                    "test:airfare-entitlement-phase1":  "node tests/airfare-entitlement-phase1.test.js",
                    "test:year-end-execution-runbook":  "node tests/year-end-execution-runbook.test.js",
                    "test:patch-2-3-89":  "node tests/continuous-entitlement-blueprint.test.js && node tests/year-end-removal-migration-plan.test.js && node tests/airfare-entitlement-phase1.test.js && node tests/year-end-execution-runbook.test.js && node tests/patch-2-3-89-continuous-entitlement.test.js",
                    "test:full":  "node tests/full-system-test.js",
                    "test:phase1":  "node tests/phase1-smoke-test.js",
                    "test:employee-status":  "node tests/employee-status-eligibility.test.js",
                    "test:year-end-safety":  "node tests/year-end-safety-contract.test.js",
                    "deploy:devops":  "powershell -ExecutionPolicy Bypass -File .\\tools\\Deploy-ATLAS-DevOps.ps1",
                    "verify:env":  "powershell -ExecutionPolicy Bypass -File .\\tools\\Verify-ATLAS-Environment.ps1"
                },
    "dependencies":  {
                         "bcryptjs":  "^2.4.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "express-rate-limit":  "^7.5.0",
                         "helmet":  "^8.0.0",
                         "joi":  "^17.13.3",
                         "jsonwebtoken":  "^9.0.2",
                         "mssql":  "^11.0.1",
                         "uuid":  "^11.0.5",
                         "winston":  "^3.17.0"
                     }
}
