# WhatsApp / Evolution (copy into C:\HCM Airfare\.env and adjust)

AIRFARE_EVOLUTION_ENABLED=true
AIRFARE_EVOLUTION_BASE_URL=http://127.0.0.1:8080
AIRFARE_EVOLUTION_API_KEY=change-me-global-evolution-key
AIRFARE_EVOLUTION_WEBHOOK_SECRET=dev-wa-webhook-secret-change-me
AIRFARE_EVOLUTION_WEBHOOK_PUBLIC_URL=https://YOUR_PUBLIC_HOST/v1/webhook/evolution
AIRFARE_WHATSAPP_DEFAULT_INSTANCE=lab-ops-bh-01
AIRFARE_WHATSAPP_PORTAL_BASE_URL=http://127.0.0.1:3389
# Optional production CTA signing (RS256 PEM). Dev falls back to HS256 jwt_secret.
# AIRFARE_WHATSAPP_CTA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
