AIRFARE_ENVIRONMENT=development
AIRFARE_DATABASE_URL=mssql+pyodbc://sa:YOUR_URL_ENCODED_PASSWORD@127.0.0.1/HCM_Airfare_Management?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
AIRFARE_JWT_SECRET=replace-with-at-least-32-random-characters
AIRFARE_JWT_ISSUER=airfare-management
AIRFARE_ACCESS_TOKEN_MINUTES=30
AIRFARE_REFRESH_TOKEN_DAYS=14
AIRFARE_PREFERENCE_CACHE_SECONDS=300
AIRFARE_REDIS_URL=redis://127.0.0.1:6379/0
AIRFARE_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
AIRFARE_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
AIRFARE_HOST=0.0.0.0
AIRFARE_PORT=3389
AIRFARE_API_BASE_URL=http://127.0.0.1:3389
AIRFARE_BOOTSTRAP_ADMIN_USERNAME=admin
AIRFARE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
AIRFARE_ATTACHMENT_ROOT=./var/attachments
AIRFARE_MAX_ATTACHMENT_BYTES=26214400
AIRFARE_BACKUP_ROOT=./var/backups
AIRFARE_BACKUP_RETENTION_DAYS=14
# Optional overrides. If empty, native .bak uses user/password from AIRFARE_DATABASE_URL.
AIRFARE_DB_USER=
AIRFARE_DB_PASSWORD=
AIRFARE_DB_SERVER=127.0.0.1
AIRFARE_CORS_ORIGINS=[]
# Local AI Data Agent (privacy-first; free path = Ollama)
AIRFARE_AI_RESEARCH_ENABLED=true
# auto = Ollama if online, else DeepSeek when key is set | ollama | deepseek | off
AIRFARE_AI_LLM_PROVIDER=auto
AIRFARE_AI_OLLAMA_ENABLED=true
AIRFARE_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Free local: deepseek-r1:1.5b (ollama pull deepseek-r1:1.5b) or llama3.2
AIRFARE_AI_OLLAMA_MODEL=qwen2.5:3b-instruct
# Optional DeepSeek cloud (OpenAI-compatible). Not always free after trial grant.
# AIRFARE_AI_DEEPSEEK_API_KEY=sk-...
AIRFARE_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AIRFARE_AI_DEEPSEEK_MODEL=deepseek-v4-flash
AIRFARE_AI_DEEPSEEK_THINKING=true
AIRFARE_AI_DEEPSEEK_REASONING_EFFORT=medium
MSSQL_SA_PASSWORD=replace-with-a-strong-SQL-password
MSSQL_SA_PASSWORD_URLENCODED=replace-with-the-URL-encoded-SQL-password
REDIS_PASSWORD=replace-with-a-strong-Redis-password
